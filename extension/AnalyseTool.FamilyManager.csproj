<Project Sdk="Microsoft.NET.Sdk">

  <!-- An external AnalyseTool extension: compiled against the SDK PACKAGE, exactly as a third-party
    author would. No ProjectReference to the platform repository — if something is missing, that is
    a gap in the SDK, and it must be closed there rather than worked around with a reference. -->

  <PropertyGroup>
    <!-- The Revit year drives the TFM, the API packages and the output folder. It arrives two ways,
         and BOTH must work: the guide (§4) teaches -p:RevitVersion=2026, while the SDK's
         PackExtension target builds through the "Release R25/R26/R27" configurations. An
         extension that understands only the first cannot be packaged. -->
    <RevitVersion Condition="'$(RevitVersion)' == '' and $(Configuration.Contains('R27'))">2027</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == '' and $(Configuration.Contains('R26'))">2026</RevitVersion>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' &lt; '2027'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' &gt;= '2027'">net10.0-windows</TargetFramework>

    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>true</ImplicitUsings>
    <Nullable>enable</Nullable>

    <RootNamespace>AnalyseTool.FamilyManager</RootNamespace>
    <AssemblyName>AnalyseTool.FamilyManager</AssemblyName>

    <!-- Output lands in <extension>\<year>\ — the layout a package uses, so the folder you develop
         in is the folder you ship, and years coexist side by side. -->
    <OutDir>$(MSBuildProjectDirectory)\$(RevitVersion)\</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exact version, never a range: a pinned package is the reason someone else's release cannot
         break your build. -->
    <PackageReference Include="AnalyseTool.Sdk" Version="1.2.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- The host owns Newtonsoft.Json at run time (the ALC shares its copy), but an extension must
         compile against it itself. Neither §4 of the guide nor Acme.Sample shows this, because
         neither serialises anything — the first gap this extraction found. The version matches
         the one pinned by the platform. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- Same for Serilog: the shared transaction-failure preprocessor uses it
         (CollectingFailuresPreprocessor from #88), without which a writing extension raises
         modal dialogs and freezes the Revit thread. The second gap. -->
    <PackageReference Include="Serilog" Version="4.2.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- Element.GetPreviewImage returns a System.Drawing.Bitmap. Compile-only — Revit provides the
         runtime copy, which is why no DLL ships beside the plugin. The version follows the year:
         RevitAPI 2027 (net10) is built against 10.x and an 8.0 reference will not do. Third gap:
         §4 of the guide does not mention it. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" Condition="'$(TargetFramework)' != 'net10.0-windows'">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" Condition="'$(TargetFramework)' == 'net10.0-windows'">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- plugin.json is NOT copied into <year>\: the manifest lives in the extension folder root, and
       <year>\ holds only the assembly. A copy in the year folder would mislead both the loader
       and the reader. -->

  <!-- UI sources are not compiled by MSBuild: Vite builds them into dist\. -->
  <ItemGroup>
    <Compile Remove="ui\**" />
    <None Remove="ui\**" />
  </ItemGroup>

</Project>
